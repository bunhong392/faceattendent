{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".indexOn": ["email"],
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "role": {
          ".validate": "newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.val() === 'member') || (!root.child('users').exists() && newData.val() === 'admin')"
        }
      }
    },

    "faceProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "attendance": {
      ".indexOn": ["timestamp"],
      ".read": "auth != null",
      "$recordId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "schedules": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "branches": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "leaveRequests": {
      ".indexOn": ["submittedAt"],
      ".read": "auth != null",
      "$requestId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "activityLogs": {
      ".indexOn": ["timestamp"],
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
